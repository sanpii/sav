{% import "macros" as macros %}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>S.A.V.</title>
        <link href="/static/lib/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" media="screen" />
        <link href="/static/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" media="screen" />
        <link href="/static/css/main.css" rel="stylesheet" media="screen" />
    </head>
    <body>
        <div class="container">
            <nav class="navbar navbar-default">
                <a class="navbar-brand" href="/">S.A.V.</a>

                <form class="d-flex">
                    <input
                        class="form-control me-2"
                        type="search"
                        placeholder="Search"
                        name="q"
                        value="{{ q|default(value="") }}"
                    />
                    <button class="btn-outline theme-primary" type="submit">Search</button>
                </form>
            </nav>

            {% if flash %}
                <div class="alert theme-{{ flash.0 }} mb-5">
                    <p>{{ flash.1 }}</p>
                </div>
            {% endif %}

            {% block content %}{% endblock %}
        </div>
    </body>
</html>
