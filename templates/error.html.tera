{% extends "base" %}

{% block title %}Internal error{% endblock %}

{% block content %}
<div class="alert theme-danger">
    Internal server error, please report this bug
    <a href="https://gitlab.com/sanpi/sav/issues">here</a>.

</div>

{% if message %}
    <div class="alert theme-danger">
        {{ message }}
    </div>
{% endif %}
{% endblock %}
